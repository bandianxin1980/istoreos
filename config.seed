CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_bd-one=y
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_PROFILE="DEVICE_bd-one"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a55"
CONFIG_ISOREOS_VERSION="24.10"
CONFIG_TARGET_ROOTFS_PARTSIZE=1600
CONFIG_TARGET_ROOTFS_EXT4=y
CONFIG_EMMC_BOOT=y

# SATA 驱动
CONFIG_PACKAGE_kmod-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-sata=y
CONFIG_PACKAGE_kmod-rockchip-sata=y

# USB/存储/文件系统
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-btrfs=y

# 5口千兆网卡
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8169=y

# HDMI/M.2
CONFIG_PACKAGE_kmod-drm=y
CONFIG_PACKAGE_kmod-nvme=y

# 官方必备组件（含Python）
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-app-docker=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 优化：关闭调试、不卡顿
# CONFIG_DEVEL is not set
CONFIG_STRIP=y
CONFIG_CCACHE=y

# 输出线刷包 img（直接刷emmc）
CONFIG_TARGET_ROOTFS_IMG=y
